#!/bin/bash
set -u

INPUT=$(cat)
FILE=$(printf '%s' "$INPUT" | jq -r '
  .postToolUse.parameters.path //
  .postToolUse.parameters.file_path //
  .postToolUse.parameters.filename //
  .preToolUse.parameters.path //
  .preToolUse.parameters.file_path //
  .preToolUse.parameters.filename //
  .tool_input.path //
  .tool_input.file_path //
  .tool_input.filename //
  .path // empty
' 2>/dev/null || true)

# Nothing to lint when the tool did not target a file.
if [ -z "$FILE" ] || [ "$FILE" = "null" ]; then
  exit 0
fi

FILE=${FILE//\\//}
while [[ "$FILE" == ./* ]]; do FILE=${FILE#./}; done
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [[ "$FILE" = /* ]]; then
  FILE=${FILE#"$REPO_ROOT"/}
fi

cd "$REPO_ROOT"
if [ ! -f "$FILE" ]; then
  exit 0
fi

case "$FILE" in
  *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.mts|*.cts)
    ;;
  *)
    exit 0
    ;;
esac

# Run the repository's installed linters only for the changed file.
if ! pnpm exec oxfmt "$FILE"; then
  exit 1
fi

if ! pnpm exec oxlint --fix "$FILE"; then
  exit 1
fi

exit 0
