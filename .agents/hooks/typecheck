#!/bin/bash
set -u

INPUT=$(cat)
FILES=$(printf '%s' "$INPUT" | jq -r '
  def jstr: fromjson? // .;
  [
    .postToolUse.parameters.path?,
    .postToolUse.parameters.file_path?,
    .postToolUse.parameters.filename?,
    (.postToolUse.parameters.files? | jstr | if type == "array" then .[]?.path else . end),
    .postToolUse.rawInput.path?,
    .postToolUse.rawInput.filePath?,
    (.postToolUse.rawInput.paths? | if type == "array" then .[] else . end),
    .preToolUse.parameters.path?,
    .preToolUse.parameters.file_path?,
    .preToolUse.parameters.filename?,
    (.preToolUse.parameters.files? | jstr | if type == "array" then .[]?.path else . end),
    (.tool_input.files? | jstr | if type == "array" then .[]?.path else . end),
    .tool_input.path?,
    .tool_input.file_path?,
    .tool_input.filename?,
    .path?
  ] | map(select(type == "string" and length > 0)) | unique | .[]
' 2>/dev/null || true)

[ -z "$FILES" ] && exit 0

HOST_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOST_ROOT="${HOST_ROOT//\\//}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=detect-pm
. "$SCRIPT_DIR/detect-pm"

# True when the tool is installed in the workspace (bunx would otherwise
# auto-install it from the registry, which a hook must never do).
ws_has_tool() {
  local ws="$1" tool="$2" ext
  for ext in "" ".exe" ".cmd"; do
    [ -e "$ws/node_modules/.bin/$tool$ext" ] && return 0
  done
  return 1
}

resolve_pm_root() {
  local target="$1"
  local dir
  if [ -d "$target" ]; then
    dir="$target"
  else
    dir="$(dirname "$target")"
  fi
  local cur="$dir"
  while true; do
    if [ -f "$cur/pnpm-workspace.yaml" ] || [ -f "$cur/pnpm-workspace.yml" ] \
      || [ -f "$cur/bun.lock" ] || [ -f "$cur/bun.lockb" ]; then
      printf '%s' "$cur"
      return 0
    fi
    local parent
    parent="$(dirname "$cur")"
    if [ "$parent" = "$cur" ]; then
      break
    fi
    cur="$parent"
  done
  local git_root
  git_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_root" ]; then
    git_root="${git_root//\\//}"
    printf '%s' "$git_root"
    return 0
  fi
  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_root" ]; then
    git_root="${git_root//\\//}"
    printf '%s' "$git_root"
    return 0
  fi
  printf '%s' "$(pwd)"
}

declare -A SEEN_WS=()
WS_LIST=()

while IFS= read -r FILE; do
  [ -n "$FILE" ] || continue

  RAW_NORM="${FILE//\\//}"
  while [[ "$RAW_NORM" == ./* ]]; do RAW_NORM="${RAW_NORM#./}"; done

  ABS=""
  if [[ "$RAW_NORM" =~ ^[A-Za-z]:/ ]] || [[ "$RAW_NORM" == /* ]]; then
    ABS="$RAW_NORM"
  else
    ABS="$HOST_ROOT/$RAW_NORM"
  fi

  if command -v realpath >/dev/null 2>&1; then
    ABS="$(realpath -m "$ABS" 2>/dev/null || printf '%s' "$ABS")"
    ABS="${ABS//\\//}"
  elif command -v readlink >/dev/null 2>&1; then
    ABS="$(readlink -m "$ABS" 2>/dev/null || printf '%s' "$ABS")"
    ABS="${ABS//\\//}"
  fi

  [ -f "$ABS" ] || continue

  case "$ABS" in
    *.ts|*.tsx|*.mts|*.cts)
      ;;
    *)
      continue
      ;;
  esac

  WS="$(resolve_pm_root "$ABS")"
  WS="${WS//\\//}"

  if [[ -z "${SEEN_WS["$WS"]:-}" ]]; then
    SEEN_WS["$WS"]=1
    WS_LIST+=("$WS")
  fi
done <<< "$FILES"

[ "${#WS_LIST[@]}" -eq 0 ] && exit 0

MAX_WS=3
if [ "${#WS_LIST[@]}" -gt "$MAX_WS" ]; then
  printf '[typecheck] skipped: %d workspaces touched (cap %d), run the typecheck script manually per workspace\n' "${#WS_LIST[@]}" "$MAX_WS"
  printf '[typecheck] workspaces: %s\n' "${WS_LIST[*]}"
  exit 0
fi

summary=""
details=""

for WS in "${WS_LIST[@]}"; do
  TSCONFIG=""
  if [ -f "$WS/tsconfig.check.json" ]; then
    TSCONFIG="tsconfig.check.json"
  elif [ -f "$WS/tsconfig.json" ]; then
    TSCONFIG="tsconfig.json"
  else
    details="${details}[typecheck] $WS: skipped (no tsconfig.json)

"
    continue
  fi

  PM="$(detect_pm "$WS")"
  if [ -z "$PM" ]; then
    details="${details}[typecheck] $WS: skipped (no lockfile — package manager unknown)

"
    continue
  fi

  if [ "$PM" = "bun" ]; then
    if grep -q '"typecheck"' "$WS/package.json" 2>/dev/null; then
      TYPECHECK_CMD=(bash -c "cd '$WS' && bun run typecheck")
    elif ws_has_tool "$WS" tsgo; then
      TYPECHECK_CMD=(bash -c "cd '$WS' && bun x tsgo --build '$TSCONFIG' --emitDeclarationOnly")
    elif ws_has_tool "$WS" tsc; then
      TYPECHECK_CMD=(bash -c "cd '$WS' && bun x tsc --build '$TSCONFIG' --emitDeclarationOnly")
    else
      TYPECHECK_CMD=()
    fi
  else
    if grep -q '"typecheck"' "$WS/package.json" 2>/dev/null; then
      TYPECHECK_CMD=(pnpm --dir "$WS" run typecheck)
    elif pnpm --dir "$WS" exec tsgo --version >/dev/null 2>&1; then
      TYPECHECK_CMD=(pnpm --dir "$WS" exec tsgo --build "$TSCONFIG" --emitDeclarationOnly)
    else
      TYPECHECK_CMD=(pnpm --dir "$WS" exec tsc --build "$TSCONFIG" --emitDeclarationOnly)
    fi
  fi

  if [ "${#TYPECHECK_CMD[@]}" -eq 0 ]; then
    details="${details}[typecheck] $WS: skipped ($PM: no tsgo, typecheck script, or tsc found)

"
    continue
  fi

  if command -v timeout >/dev/null 2>&1; then
    OUTPUT="$(timeout 120 "${TYPECHECK_CMD[@]}" 2>&1)"
    EXIT_CODE=$?
  else
    OUTPUT="$("${TYPECHECK_CMD[@]}" 2>&1)"
    EXIT_CODE=$?
  fi

  if [ "$EXIT_CODE" -eq 124 ]; then
    summary="${summary}[typecheck] $WS ($TSCONFIG): issues
"
    details="${details}[typecheck] $WS: timed out (120s) running ${TYPECHECK_CMD[*]}

"
  elif [ "$EXIT_CODE" -ne 0 ]; then
    OUTPUT="$(printf '%s' "$OUTPUT" | sed '/\[WARN\] Ignored project-level auth setting/d')"
    summary="${summary}[typecheck] $WS ($TSCONFIG): issues
"
    details="${details}[typecheck] $WS ($TSCONFIG) reported issues
$OUTPUT

"
  else
    summary="${summary}[typecheck] $WS ($TSCONFIG): ok
"
  fi
done

if [ -n "$summary" ]; then
  printf '%s' "$summary"
fi
if [ -n "$details" ]; then
  printf '\n%s' "$details"
fi

exit 0
