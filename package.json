{
	"name": "rbxts-game-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"barrels": "barrelsby --delete --config .barrelsby.json && barrelsby --delete --config .barrelsby-systems.json",
		"bedrock:build": "sh scripts/bash/setup-place.sh default.project.json build/production.rbxl",
		"bedrock:deploy": "bedrock -- deploy --env production",
		"bedrock:diff": "bedrock -- diff --env production",
		"bedrock:publish": "bedrock -- publish --env production",
		"build": "pnpm -r --if-present run \"/^build.*/\" && pnpm build:source",
		"build:source": "pnpm clean:source && rbxtsc --type 'game' --includePath packages/@internal/shared/node_modules/@lisachandra/types/out/include --noInclude --verbose --allowCommentDirectives",
		"clean": "pnpm -r --include-workspace-root --parallel run \"/^clean:.*/\"",
		"clean:source": "shx rm -rf out flamework.build sourcemap.json",
		"clean:test": "shx rm -rf .jest-roblox build/production.rbxl game-output.log jest-output.log",
		"commit": "cz",
		"darklua": "darklua process out out --verbose && darklua minify out out --verbose",
		"dev": "pnpm -r --include-workspace-root --parallel run \"/^dev:.*/\"",
		"dev:rbx-tree": "io-serve",
		"dev:source": "rbxtsc --type 'game' --includePath packages/@internal/shared/node_modules/@lisachandra/types/out/include --noInclude --watch --allowCommentDirectives",
		"dev:sourcemap": "rojo sourcemap --watch default.project.json --output sourcemap.json",
		"drillbit": "drillbit",
		"eslint-config": "pnpx @eslint/config-inspector",
		"postinstall": "node ./scripts/javascript/hoist.mjs",
		"lint": "oxfmt --check && oxlint",
		"lint:fix": "oxfmt && oxlint --fix",
		"prepare": "node .husky/install.mjs",
		"release": "commit-and-tag-version --sign --no-verify",
		"release:dispatch": "gh workflow run release.yaml -f release_as=auto",
		"release:dispatch:major": "gh workflow run release.yaml -f release_as=major",
		"release:dispatch:minor": "gh workflow run release.yaml -f release_as=minor",
		"release:dispatch:patch": "gh workflow run release.yaml -f release_as=patch",
		"release:dry": "commit-and-tag-version --dry-run --skip.commit --skip.tag",
		"serve": "rojo serve default.project.json",
		"setup": "pnpm submodules && pnpm install --frozen-lockfile && pnpm build",
		"submodules": "bash ./scripts/bash/submodule-setup.sh",
		"typecheck": "tsgo --build tsconfig.check.json --emitDeclarationOnly",
		"test": "pnpm clean:test && pnpm bedrock:build && COLUMNS=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)} FORCE_COLOR=1 jest-roblox",
		"test:local": "sh scripts/bash/test.sh default.project.json src/test/spec.server.luau",
		"test:slow": "INCLUDE_SLOW=1 pnpm test"
	},
	"dependencies": {
		"type-fest": "catalog:"
	},
	"devDependencies": {
		"@bedrock-rbx/core": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/prompt-cli": "catalog:",
		"@commitlint/types": "catalog:",
		"@isentinel/dict-rbxts": "catalog:",
		"@isentinel/dict-roblox": "catalog:",
		"@isentinel/dict-wally": "catalog:",
		"@isentinel/eslint-config": "catalog:",
		"@isentinel/jest-roblox": "file:submodules\\jest-roblox-cli",
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/types": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"@typescript/native-preview": "catalog:",
		"barrelsby": "catalog:",
		"commit-and-tag-version": "catalog:",
		"husky": "catalog:",
		"io-serve": "catalog:",
		"jiti": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"rbxts-transformer-flamework": "catalog:",
		"shx": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
