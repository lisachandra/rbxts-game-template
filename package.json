{
	"name": "rbxts-game-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"barrels": "barrelsby --delete --config .barrelsby.json && barrelsby --delete --config .barrelsby-systems.json",
		"bedrock:build": "sh scripts/bash/setup-place.sh build.project.json build/production.rbxl",
		"bedrock:deploy": "mise run bedrock -- deploy --env production",
		"bedrock:diff": "mise run bedrock -- diff --env production",
		"bedrock:provision": "mise run bedrock -- provision --env production",
		"bedrock:publish": "mise run bedrock -- publish --env production",
		"build": "pnpm -r --if-present run \"/^build.*/\" && pnpm hoist && pnpm build:source",
		"build:source": "pnpm clean:source && sloptor build --type 'game' --includePath packages/@internal/shared/node_modules/@lisachandra/types/out/include --noInclude --verbose --allowCommentDirectives",
		"check:pnpm-version": "node ./scripts/javascript/checkPnpmVersion.mjs",
		"clean": "pnpm -r --include-workspace-root --parallel run \"/^clean:.*/\"",
		"clean:source": "shx rm -rf out flamework.build sourcemap.json",
		"clean:test": "shx rm -rf .jest-roblox build/production.rbxl game-output.log jest-output.log",
		"commit": "cz",
		"darklua": "darklua process out out --verbose && darklua minify out out --verbose",
		"dev": "pnpm -r --include-workspace-root --parallel run \"/^dev:.*/\"",
		"dev:rbx-tree": "io-serve",
		"dev:source": "sloptor build --type 'game' --includePath packages/@internal/shared/node_modules/@lisachandra/types/out/include --noInclude --watch --allowCommentDirectives",
		"dev:sourcemap": "rojo sourcemap --watch default.project.json --output sourcemap.json",
		"drillbit": "drillbit",
		"emu:server-probe": "ree run --harness scripts/emulator/server-scenarios/server-probe.luau --mount ServerScriptService/TS=out/server --mount ReplicatedStorage/TS=out/shared --mode play --seconds 2 --context '{}'",
		"eslint-config": "pnpx @eslint/config-inspector",
		"hoist": "node ./scripts/javascript/hoist.mjs",
		"lint": "oxfmt --check && oxlint --disable-nested-config",
		"lint:fix": "oxfmt && oxlint --fix --disable-nested-config && oxfmt",
		"postinstall": "node ./scripts/javascript/hoist.mjs",
		"preinstall": "node ./scripts/javascript/checkPnpmVersion.mjs",
		"prepare": "node .husky/install.mjs",
		"release": "commit-and-tag-version --sign --no-verify",
		"release:dispatch": "gh workflow run release.yaml -f release_as=auto",
		"release:dispatch:major": "gh workflow run release.yaml -f release_as=major",
		"release:dispatch:minor": "gh workflow run release.yaml -f release_as=minor",
		"release:dispatch:patch": "gh workflow run release.yaml -f release_as=patch",
		"release:dry": "commit-and-tag-version --dry-run --skip.commit --skip.tag",
		"serve": "rojo serve default.project.json",
		"setup": "pnpm submodules && pnpm install --frozen-lockfile && pnpm build && pnpm hoist",
		"submodules": "bash ./scripts/bash/submodule-setup.sh",
		"test": "pnpm clean:test && pnpm build && pnpm hoist && pnpm ui:templates && sh scripts/bash/test.sh default.project.json src/test/spec.server.luau --",
		"typecheck": "node ./scripts/javascript/typecheck.mjs",
		"ui:render": "node scripts/javascript/uiRender.mjs",
		"ui:templates": "lune run scripts/luau/scaffoldContainers.luau default.project.json build/ui-templates",
		"ui:templates:export": "lune run scripts/luau/exportUiTemplates.luau"
	},
	"dependencies": {
		"type-fest": "catalog:"
	},
	"devDependencies": {
		"@bedrock-rbx/core": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/prompt-cli": "catalog:",
		"@commitlint/types": "catalog:",
		"@isentinel/dict-rbxts": "catalog:",
		"@isentinel/dict-roblox": "catalog:",
		"@isentinel/dict-wally": "catalog:",
		"@isentinel/eslint-config": "catalog:",
		"@isentinel/jest-roblox": "https://github.com/lisachandra/jest-roblox-cli/releases/download/v0.4.12-fork.1/isentinel-jest-roblox-0.4.12-fork.1.tgz",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/sandcastle": "catalog:",
		"@lisachandra/types": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"barrelsby": "catalog:",
		"commit-and-tag-version": "catalog:",
		"husky": "catalog:",
		"io-serve": "catalog:",
		"jiti": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"rbxts-transformer-flamework": "catalog:",
		"rbxts-transformer-xstate": "catalog:",
		"roblox-ui-renderer": "github:Anime-Vanguards/roblox-ui-renderer#72b31c33f49fd1c234426b01c25fba53456306dd",
		"shx": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@12.16.1"
}
