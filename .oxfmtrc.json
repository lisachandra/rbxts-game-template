{
	"$schema": "./node_modules/.pnpm/oxfmt@0.59.0/node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"printWidth": 100,
	"quoteProps": "consistent",
	"semi": true,
	"singleQuote": false,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true,
	"endOfLine": "lf",
	"jsdoc": true,
	"sortImports": false,
	"sortPackageJson": true,
	"embeddedLanguageFormatting": "auto",
	"ignorePatterns": [
		".husky/install.mjs",
		"src/types/services/**",
		"submodules/**",
		".agents/**",
		"src/**/constants.json",
		"packages/**",
		"**/barrel.ts",
		"!packages/@internal/**",
		"**/pnpm-lock.yaml"
	],
	"overrides": [
		{
			"files": [".github/**/*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
