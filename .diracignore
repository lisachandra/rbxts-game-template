!**/coverage
!**/coverage/
!.nyc_output
!.nyc_output/
!**/.nyc_output
!**/.nyc_output/
!__snapshots__
!__snapshots__/
!**/__snapshots__
!**/__snapshots__/

# Ignore all contents by default
dist/**
**/dist/**
build/**
**/build/**
out/**
**/out/**
target/**
**/target/**
bin/**
**/bin/**
obj/**
**/obj/**
generated/**
**/generated/**
gen/**
**/gen/**
CMakeFiles/**
**/CMakeFiles/**
.gradle/**
**/.gradle/**
.turbo/**
**/.turbo/**
.next/**
**/.next/**
.nuxt/**
**/.nuxt/**
.svelte-kit/**
**/.svelte-kit/**
coverage/**
**/coverage/**
.nyc_output/**
**/.nyc_output/**
__snapshots__/**
**/__snapshots__/**

# Re-allow subdirectories so deeper globs can match
!dist/**/
!**/dist/**/
!build/**/
!**/build/**/
!out/**/
!**/out/**/
!target/**/
!**/target/**/
!bin/**/
!**/bin/**/
!obj/**/
!**/obj/**/
!generated/**/
!**/generated/**/
!gen/**/
!**/gen/**/
!CMakeFiles/**/
!**/CMakeFiles/**/
!.gradle/**/
!**/.gradle/**/
!.turbo/**/
!**/.turbo/**/
!.next/**/
!**/.next/**/
!.nuxt/**/
!**/.nuxt/**/
!.svelte-kit/**/
!**/.svelte-kit/**/
!coverage/**/
!**/coverage/**/
!.nyc_output/**/
!**/.nyc_output/**/
!__snapshots__/**/
!**/__snapshots__/**/

# Allow traversal into node_modules
!node_modules
!node_modules/
!**/node_modules
!**/node_modules/

# Ignore all contents by default
node_modules/**
**/node_modules/**

# Re-allow subdirectories so deeper globs can match
!node_modules/**/
!**/node_modules/**/

# Allow hoisted public package patterns from .npmrc
!**/node_modules/@rbxts/
!**/node_modules/@rbxts/**
!**/node_modules/@lisachandra/
!**/node_modules/@lisachandra/**
!**/node_modules/@flamework/
!**/node_modules/@flamework/**
!**/node_modules/@rbxts-js/
!**/node_modules/@rbxts-js/**

# Allow specific file types inside node_modules
!**/node_modules/**/*.d.ts
!**/node_modules/**/*.d.tsx
!**/node_modules/**/*.luau
!**/node_modules/**/*.ts
!**/node_modules/**/*.tsx
!**/node_modules/**/*.json
!**/node_modules/**/*.md
