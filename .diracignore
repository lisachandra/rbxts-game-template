# Allow traversal into packages
!dist
!dist/
!**/dist
!**/dist/
!build
!build/
!**/build
!**/build/
!out
!out/
!**/out
!**/out/
!target
!target/
!**/target
!**/target/
!bin
!bin/
!**/bin
!**/bin/
!obj
!obj/
!**/obj
!**/obj/
!generated
!generated/
!**/generated
!**/generated/
!gen
!gen/
!**/gen
!**/gen/
!CMakeFiles
!CMakeFiles/
!**/CMakeFiles
!**/CMakeFiles/
!.gradle
!.gradle/
!**/.gradle
!**/.gradle/
!.turbo
!.turbo/
!**/.turbo
!**/.turbo/
!.next
!.next/
!**/.next
!**/.next/
