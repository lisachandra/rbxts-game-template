{
	"extends": ["./tsconfig.build.json", "@isentinel/tsconfig/typescript"],
	"compilerOptions": {
		"tsBuildInfoFile": "${configDir}/tsconfig.node.tsbuildinfo",
		"composite": true,
		"noLib": false,
		"rootDir": "${configDir}",
		"typeRoots": ["./node_modules/@types"],
		"types": ["node"],
		"noEmit": false,
		"customConditions": []
	},
	"files": [],
	"include": ["**/*.config.ts"],
	"exclude": ["node_modules", "submodules", "out", "build", "coverage"]
}
